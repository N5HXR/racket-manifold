;; Included lexically by ../units.rkt. This file intentionally has no #lang.

(provide
 (struct-out ray-hit)
 point3 point3? point3-x point3-y point3-z
 triangle triangle? triangle-a triangle-b triangle-c
 mesh mesh? mesh-vertices mesh-triangles
 cross-section? cross-section-close! cross-section-closed?
 polygon polygons square circle cross-section-copy cross-section-empty?
 cross-section-union cross-section-difference cross-section-intersection
 cross-section-hull cross-section-offset cross-section-simplify
 cross-section-translate cross-section-rotate cross-section-scale
 cross-section-mirror cross-section-transform cross-section-warp
 cross-section-area cross-section-num-vertices cross-section-num-contours
 cross-section-bounds cross-section->polygons
 extrude revolve solid-slice solid-project split split-by-plane warp
 level-set solid->mesh mesh->solid solid-ray-cast
 read-obj read-obj-file solid->obj-string write-obj)

(define point3 core:point3)
(define point3? core:point3?)
(define point3-x core:point3-x)
(define point3-y core:point3-y)
(define point3-z core:point3-z)
(define triangle core:triangle)
(define triangle? core:triangle?)
(define triangle-a core:triangle-a)
(define triangle-b core:triangle-b)
(define triangle-c core:triangle-c)
(define mesh core:mesh)
(define mesh? core:mesh?)
(define mesh-vertices core:mesh-vertices)
(define mesh-triangles core:mesh-triangles)

(struct physical-cross-section (core))
(struct ray-hit (face-id distance position normal) #:transparent)
(define cross-section? physical-cross-section?)
(define (section-core who value)
  (unless (cross-section? value) (raise-argument-error who "cross-section?" value))
  (physical-cross-section-core value))
(define (wrap-section value) (physical-cross-section value))
(define (cross-section-close! value) (core:cross-section-close! (section-core 'cross-section-close! value)))
(define (cross-section-closed? value) (core:cross-section-closed? (section-core 'cross-section-closed? value)))

(define (physical-point2 who value)
  (define items
    (cond [(and (list? value) (= (length value) 2)) value]
          [(and (vector? value) (= (vector-length value) 2)) (vector->list value)]
          [else (raise-argument-error who "two-element point list or vector" value)]))
  (map (lambda (item) (physical-value who item)) items))
(define (physical-contour who contour)
  (unless (sequence? contour) (raise-argument-error who "sequence?" contour))
  (for/list ([point contour]) (physical-point2 who point)))
(define (polygon points #:fill-rule [fill-rule 'nonzero])
  (wrap-section (core:polygon (physical-contour 'polygon points) #:fill-rule fill-rule)))
(define (polygons contours #:fill-rule [fill-rule 'nonzero])
  (unless (sequence? contours) (raise-argument-error 'polygons "sequence?" contours))
  (wrap-section
   (core:polygons (for/list ([contour contours]) (physical-contour 'polygons contour))
                  #:fill-rule fill-rule)))
(define (square x [y x] #:center? [center? #f])
  (wrap-section (core:square (physical-value 'square x) (physical-value 'square y)
                             #:center? center?)))
(define (circle radius #:segments [segments (current-circular-segments)])
  (wrap-section (core:circle (physical-value 'circle radius) #:segments segments)))
(define (cross-section-copy section) (wrap-section (core:cross-section-copy (section-core 'cross-section-copy section))))
(define (cross-section-empty? section) (core:cross-section-empty? (section-core 'cross-section-empty? section)))
(define (section-cores who values)
  (map (lambda (value) (section-core who value)) values))
(define (cross-section-union first . rest) (wrap-section (apply core:cross-section-union (section-cores 'cross-section-union (cons first rest)))))
(define (cross-section-difference first . rest) (wrap-section (apply core:cross-section-difference (section-cores 'cross-section-difference (cons first rest)))))
(define (cross-section-intersection first . rest) (wrap-section (apply core:cross-section-intersection (section-cores 'cross-section-intersection (cons first rest)))))
(define (cross-section-hull first . rest) (wrap-section (apply core:cross-section-hull (section-cores 'cross-section-hull (cons first rest)))))
(define (cross-section-offset section delta #:join [join 'round]
                              #:miter-limit [miter-limit 2]
                              #:segments [segments (current-circular-segments)])
  (wrap-section (core:cross-section-offset (section-core 'cross-section-offset section)
                  (physical-value 'cross-section-offset delta) #:join join
                  #:miter-limit miter-limit #:segments segments)))
(define (cross-section-simplify section [tolerance 0])
  (wrap-section (core:cross-section-simplify (section-core 'cross-section-simplify section)
                  (if (zero? tolerance) 0 (physical-value 'cross-section-simplify tolerance)))))
(define (cross-section-translate section offset [y #f])
  (define converted (if y (list (physical-value 'cross-section-translate offset)
                                (physical-value 'cross-section-translate y))
                        (physical-point2 'cross-section-translate offset)))
  (wrap-section (core:cross-section-translate (section-core 'cross-section-translate section) converted)))
(define (cross-section-rotate section degrees) (wrap-section (core:cross-section-rotate (section-core 'cross-section-rotate section) degrees)))
(define (cross-section-scale section x [y x]) (wrap-section (core:cross-section-scale (section-core 'cross-section-scale section) x y)))
(define (cross-section-mirror section axis) (wrap-section (core:cross-section-mirror (section-core 'cross-section-mirror section) axis)))
(define (cross-section-transform section matrix)
  (unless (and (list? matrix) (= (length matrix) 2)
               (andmap (lambda (row) (and (list? row) (= (length row) 3))) matrix))
    (raise-argument-error 'cross-section-transform "two lists of three values" matrix))
  (define converted
    (list (list (list-ref (car matrix) 0) (list-ref (car matrix) 1)
                (physical-value 'cross-section-transform (list-ref (car matrix) 2)))
          (list (list-ref (cadr matrix) 0) (list-ref (cadr matrix) 1)
                (physical-value 'cross-section-transform (list-ref (cadr matrix) 2)))))
  (wrap-section (core:cross-section-transform (section-core 'cross-section-transform section) converted)))
(define (cross-section-warp section procedure)
  (define selected (active-unit 'cross-section-warp))
  (define factor (unit-scale selected))
  (wrap-section
   (core:cross-section-warp (section-core 'cross-section-warp section)
    (lambda (x y)
      (define result (procedure (/ x factor) (/ y factor)))
      (physical-point2 'cross-section-warp result)))))
(define (cross-section-area section)
  (define factor (unit-scale (active-unit 'cross-section-area)))
  (/ (core:cross-section-area (section-core 'cross-section-area section)) (* factor factor)))
(define (cross-section-num-vertices section) (core:cross-section-num-vertices (section-core 'cross-section-num-vertices section)))
(define (cross-section-num-contours section) (core:cross-section-num-contours (section-core 'cross-section-num-contours section)))
(define (scale-point2-from-metres point factor) (map (lambda (x) (/ x factor)) point))
(define (cross-section-bounds section)
  (define factor (unit-scale (active-unit 'cross-section-bounds)))
  (define-values (lo hi) (core:cross-section-bounds (section-core 'cross-section-bounds section)))
  (values (scale-point2-from-metres lo factor) (scale-point2-from-metres hi factor)))
(define (cross-section->polygons section)
  (define factor (unit-scale (active-unit 'cross-section->polygons)))
  (for/list ([contour (core:cross-section->polygons (section-core 'cross-section->polygons section))])
    (for/list ([point contour]) (scale-point2-from-metres point factor))))

(define (extrude section height #:slices [slices 0] #:twist [twist 0] #:scale [scale-value '(1 1)])
  (wrap (core:extrude (section-core 'extrude section) (physical-value 'extrude height)
                      #:slices slices #:twist twist #:scale scale-value)))
(define (revolve section #:segments [segments (current-circular-segments)] #:degrees [degrees 360])
  (wrap (core:revolve (section-core 'revolve section) #:segments segments #:degrees degrees)))
(define (solid-slice value height) (wrap-section (core:solid-slice (solid->unitless value) (physical-value 'solid-slice height))))
(define (solid-project value) (wrap-section (core:solid-project (solid->unitless value))))
(define (split value cutter)
  (define-values (a b) (core:split (solid->unitless value) (solid->unitless cutter)))
  (values (wrap a) (wrap b)))
(define (split-by-plane value normal offset)
  (define-values (a b) (core:split-by-plane (solid->unitless value) normal (physical-value 'split-by-plane offset)))
  (values (wrap a) (wrap b)))
(define (warp value procedure)
  (define factor (unit-scale (active-unit 'warp)))
  (wrap (core:warp (solid->unitless value)
    (lambda (x y z) (physical-point 'warp (procedure (/ x factor) (/ y factor) (/ z factor)))))))
(define (level-set procedure minimum maximum edge-length #:level [level 0] #:tolerance [tolerance -1])
  (define factor (unit-scale (active-unit 'level-set)))
  (wrap (core:level-set
         (lambda (x y z) (physical-value 'level-set (procedure (/ x factor) (/ y factor) (/ z factor))))
         (physical-point 'level-set minimum) (physical-point 'level-set maximum)
         (physical-value 'level-set edge-length)
         #:level (physical-value 'level-set level)
         #:tolerance (if (negative? tolerance) -1 (physical-value 'level-set tolerance)))))

(define (solid->mesh value)
  (define factor (unit-scale (active-unit 'solid->mesh)))
  (define source (core:solid->mesh (solid->unitless value)))
  (core:mesh
   (for/vector ([p (in-vector (core:mesh-vertices source))])
     (core:point3 (/ (core:point3-x p) factor) (/ (core:point3-y p) factor)
                  (/ (core:point3-z p) factor)))
   (core:mesh-triangles source)))
(define (mesh->solid value)
  (unless (core:mesh? value) (raise-argument-error 'mesh->solid "mesh?" value))
  (define factor (unit-scale (active-unit 'mesh->solid)))
  (wrap (core:mesh->solid
         (core:mesh
          (for/vector ([p (in-vector (core:mesh-vertices value))])
            (core:point3 (* (core:point3-x p) factor) (* (core:point3-y p) factor)
                         (* (core:point3-z p) factor)))
          (core:mesh-triangles value)))))
(define (solid-ray-cast value origin end)
  (define factor (unit-scale (active-unit 'solid-ray-cast)))
  (for/list ([hit (core:solid-ray-cast (solid->unitless value)
                   (physical-point 'solid-ray-cast origin) (physical-point 'solid-ray-cast end))])
    (define p (core:ray-hit-position hit))
    (define n (core:ray-hit-normal hit))
    (ray-hit (core:ray-hit-face-id hit) (/ (core:ray-hit-distance hit) factor)
             (list (/ (core:point3-x p) factor) (/ (core:point3-y p) factor) (/ (core:point3-z p) factor))
             (list (core:point3-x n) (core:point3-y n) (core:point3-z n)))))

(define (read-obj source)
  (define raw (core:read-obj source))
  (define scaled (core:scale raw (unit-scale (active-unit 'read-obj))))
  (core:solid-close! raw)
  (wrap scaled))
(define (read-obj-file path)
  (unless (path-string? path) (raise-argument-error 'read-obj-file "path-string?" path))
  (call-with-input-file path read-obj))
(define (solid->obj-string value)
  (define scaled (scaled-for-export 'solid->obj-string value #f))
  (dynamic-wind void (lambda () (core:solid->obj-string scaled))
                (lambda () (core:solid-close! scaled))))
(define (write-obj value destination)
  (define text (solid->obj-string value))
  (cond [(output-port? destination) (display text destination)]
        [(path-string? destination)
         (call-with-output-file destination (lambda (port) (display text port)) #:exists 'replace)]
        [else (raise-argument-error 'write-obj "(or/c path-string? output-port?)" destination)]))
