#lang racket/base

(require rackunit
         racket/math
         (prefix-in ll: manifold/low-level)
         manifold/private/library)

(define (close-all . values)
  (for ([value (in-list values)]) (ll:native-handle-close! value)))

(unless (manifold-library-available?)
  (eprintf "Skipping native Manifold integration tests: libmanifoldc is unavailable\n"))

(when (manifold-library-available?)

(test-case "managed polygons, cross sections, triangulation, and extrusion"
  (define outline (ll:simple-polygon '((0 0) (2 0) (2 1) (0 1))))
  (define outlines (ll:polygons (list outline)))
  (check-equal? (ll:simple-polygon-length outline) 4)
  (check-equal? (ll:polygons-length outlines) 1)
  (check-equal? (ll:polygons-point outlines 0 2) (ll:vec2 2.0 1.0))
  (define section (ll:cross-section-of-polygons outlines))
  (define moved (ll:cross-section-translate section 1 2))
  (check-equal? (ll:cross-section-area moved) 2.0)
  (define bounds (ll:cross-section-bounds moved))
  (check-equal? (ll:rect-min bounds) (ll:vec2 1.0 2.0))
  (check-equal? (ll:rect-max bounds) (ll:vec2 3.0 3.0))
  (define moved-polygons (ll:cross-section->polygons moved))
  (define solid (ll:manifold-extrude moved-polygons 3))
  (check-= (ll:manifold-volume solid) 6.0 1e-9)
  (define triangles (ll:triangulate moved-polygons))
  (check-equal? (ll:triangulation-num-triangles triangles) 2)
  (check-equal? (vector-length (ll:triangulation-triangles triangles)) 2)
  (close-all outline outlines section moved bounds moved-polygons solid triangles))

(test-case "managed rectangle and box operations"
  (define r (ll:rect 0 0 2 3))
  (check-true (ll:rect-contains-point? r 1 1))
  (ll:rect-include-point! r -1 4)
  (check-equal? (ll:rect-dimensions r) (ll:vec2 3.0 4.0))
  (define b (ll:box 0 0 0 2 3 4))
  (check-true (ll:box-contains-point? b 1 1 1))
  (define shifted (ll:box-translate b 2 0 0))
  (check-true (ll:box-overlaps-box? b shifted))
  (close-all r b shifted))

(test-case "managed split, projection, decomposition, hull points, and ray hits"
  (define a (ll:manifold-cube 2 2 2 #t))
  (define cutter (ll:manifold-cube 1 3 3 #t))
  (define-values (inside outside) (ll:manifold-split a cutter))
  (check-= (ll:manifold-volume inside) 4.0 1e-9)
  (check-= (ll:manifold-volume outside) 4.0 1e-9)
  (define projected (ll:manifold-project a))
  (check-equal? (ll:polygons-length projected) 1)
  (define hull (ll:manifold-hull-points '((0 0 0) (1 0 0) (0 1 0) (0 0 1))))
  (check-= (ll:manifold-volume hull) (/ 1.0 6.0) 1e-9)
  (define pieces (ll:manifold-decompose a))
  (check-equal? (length pieces) 1)
  (define hits (ll:manifold-ray-cast a '(-2 0 0) '(2 0 0)))
  (check-equal? (length hits) 2)
  (check-true (andmap ll:ray-hit? hits))
  (apply close-all (append (list a cutter inside outside projected hull) pieces)))

(test-case "managed mesh extraction, construction, and OBJ round trip"
  (define cube (ll:manifold-cube 1 1 1))
  (define mesh (ll:manifold-get-meshgl64 cube))
  (check-equal? (vector-length (ll:meshgl64-vertex-properties mesh))
                (* (ll:meshgl64-num-prop mesh) (ll:meshgl64-num-vert mesh)))
  (check-equal? (vector-length (ll:meshgl64-triangle-vertices mesh))
                (* 3 (ll:meshgl64-num-tri mesh)))
  (define copied (ll:meshgl64-copy mesh))
  (define rebuilt (ll:manifold-of-meshgl64 copied))
  (check-= (ll:manifold-volume rebuilt) 1.0 1e-9)
  (define obj (ll:manifold-write-obj cube))
  (check-true (regexp-match? #rx"^#" obj))
  (define imported (ll:manifold-read-obj obj))
  (check-= (ll:manifold-volume imported) 1.0 1e-9)
  (close-all cube mesh copied rebuilt imported))

(test-case "managed callbacks and execution context"
  (define bounds (ll:box -1.25 -1.25 -1.25 1.25 1.25 1.25))
  (define (sphere-sdf x y z) (- (sqrt (+ (* x x) (* y y) (* z z))) 1))
  (define solid (ll:manifold-level-set-sequential sphere-sdf bounds 0.35))
  (check-equal? (ll:manifold-status solid) 'no-error)
  (check-true (> (ll:manifold-volume solid) 3.0))
  (define warped (ll:manifold-warp solid (lambda (x y z) (list (+ x (* 0.1 z)) y z))))
  (check-equal? (ll:manifold-status warped) 'no-error)
  (define ec (ll:execution-context))
  (check-false (ll:execution-context-cancelled? ec))
  (check-true (<= 0.0 (ll:execution-context-progress ec) 1.0))
  (ll:execution-context-cancel! ec)
  (check-true (ll:execution-context-cancelled? ec))
  (close-all bounds solid warped ec))

(test-case "managed native vector facades copy members safely"
  (define cube (ll:manifold-cube 1 1 1))
  (define mv (ll:manifold-vector))
  (ll:manifold-vector-reserve! mv 2)
  (ll:manifold-vector-add! mv cube)
  (check-equal? (ll:manifold-vector-length mv) 1)
  (define cube-copy (ll:manifold-vector-ref mv 0))
  (check-= (ll:manifold-volume cube-copy) 1.0 1e-9)
  (define section (ll:cross-section-square 2 3))
  (define csv (ll:cross-section-vector))
  (ll:cross-section-vector-add! csv section)
  (check-equal? (ll:cross-section-vector-length csv) 1)
  (define section-copy (ll:cross-section-vector-ref csv 0))
  (check-= (ll:cross-section-area section-copy) 6.0 1e-9)
  (close-all cube mv cube-copy section csv section-copy))

(test-case "managed mesh constructors and optional metadata"
  (define props '(0 0 0  1 0 0  0 1 0))
  (define tris '(0 1 2))
  (define mesh32 (ll:meshgl props 3 tris))
  (check-equal? (ll:meshgl-num-vertices mesh32) 3)
  (check-equal? (ll:meshgl-triangle-vertices mesh32) #(0 1 2))
  (define mesh64 (ll:meshgl64-with-options
                  props 3 tris (ll:mesh-options #f #f #f #f #f)))
  (check-equal? (ll:meshgl64-num-vert mesh64) 3)
  (check-equal? (ll:meshgl64-triangle-vertices mesh64) #(0 1 2))
  (define text (ll:meshgl64-write-obj mesh64))
  (define imported (ll:meshgl64-read-obj text))
  (check-equal? (ll:meshgl64-num-tri imported) 1)
  (close-all mesh32 mesh64 imported))

(test-case "managed property callback, normals, and quality controls"
  (define cube (ll:manifold-cube 1 1 1))
  (define with-property
    (ll:manifold-set-properties cube 1
      (lambda (position old) (vector (ll:vec3-z position)))))
  (check-equal? (ll:manifold-num-properties with-property) 1)
  (define with-curvature (ll:manifold-calculate-curvature with-property 1 2))
  (check-equal? (ll:manifold-num-properties with-curvature) 3)
  (define with-normals (ll:manifold-calculate-normals with-curvature 3 60))
  (check-equal? (ll:manifold-status with-normals) 'no-error)
  (define old-precision (ll:relative-precision))
  (dynamic-wind
    (lambda () (ll:set-relative-precision! 1e-10))
    (lambda () (check-= (ll:relative-precision) 1e-10 1e-20))
    (lambda () (ll:set-relative-precision! old-precision)
               (ll:reset-circular-defaults!)))
  (close-all cube with-property with-curvature with-normals)))
